generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  avatar    String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isPremium Boolean @default(false)

  addresses      Address[]
  orders         Order[]
  favourites     Favourite[]
  paymentMethods PaymentMethod[]
  notifications  NotificationPreference?
  vouchers       UserVoucher[]
  refreshToken           String?
  resetPasswordToken     String?
  resetPasswordExpires   DateTime?
}

enum Role {
  CUSTOMER
  ADMIN
  STORE_MANAGER
  RIDER
}

model Address {
  id        String  @id @default(uuid())
  label     String  @default("Home")
  detail    String
  latitude  Float?
  longitude Float?
  isDefault Boolean @default(false)
  userId    String
  user      User    @relation(fields: [userId], references: [id])
}

model PaymentMethod {
  id        String  @id @default(uuid())
  type      PaymentType
  last4     String?
  expiry    String?
  brand     String?
  token     String? // Stripe/Paypal token
  isDefault Boolean @default(false)
  userId    String
  user      User    @relation(fields: [userId], references: [id])
}

enum PaymentType {
  CARD
  PAYPAL
  APPLE_PAY
  GOOGLE_PAY
  CASH
}

model NotificationPreference {
  id                String  @id @default(uuid())
  emailEnabled      Boolean @default(true)
  smsEnabled        Boolean @default(false)
  pushEnabled       Boolean @default(true)
  promotionalEnabled Boolean @default(true)
  userId            String  @unique
  user              User    @relation(fields: [userId], references: [id])
}

model Store { // Mart
  id           String    @id @default(uuid())
  name         String
  image        String?
  description  String?
  rating       Float     @default(0)
  deliveryTime String?   // "30-45 min"
  minOrder     Float     @default(0)
  deliveryFee  Float     @default(0)
  isActive     Boolean   @default(true)
  
  categories   Category[]
  products     Product[]
  orders       Order[]
}

model Category {
  id      String    @id @default(uuid())
  name    String
  image   String?
  storeId String
  store   Store     @relation(fields: [storeId], references: [id])
  products Product[]
}

model Product {
  id            String    @id @default(uuid())
  name          String
  description   String?
  image         String?
  price         Float
  discountPrice Float?
  stock         Int       @default(0)
  rating        Float     @default(0)
  reviewsCount  Int       @default(0)
  
  categoryId    String
  category      Category  @relation(fields: [categoryId], references: [id])
  storeId       String
  store         Store     @relation(fields: [storeId], references: [id])

  orderItems    OrderItem[]
  favourites    Favourite[]
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   String      @unique // e.g. #ORD-12345
  status        OrderStatus @default(PENDING)
  total         Float
  subtotal      Float
  deliveryFee   Float
  discount      Float       @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  storeId       String
  store         Store       @relation(fields: [storeId], references: [id])
  
  items         OrderItem[]
  address       String      // Snapshot of delivery address
  paymentMethod String      // Snapshot of payment method
  trackingUrl   String?
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPING
  COMPLETED
  CANCELLED
}

model OrderItem {
  id        String  @id @default(uuid())
  quantity  Int
  price     Float   // Price at time of purchase
  total     Float
  
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model Voucher {
  id          String   @id @default(uuid())
  code        String   @unique
  description String?
  discountType DiscountType
  value       Float
  minSpend    Float?
  maxDiscount Float?
  expiryDate  DateTime
  isActive    Boolean  @default(true)
  
  users       UserVoucher[]
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model UserVoucher {
  id        String   @id @default(uuid())
  isUsed    Boolean  @default(false)
  usedAt    DateTime?
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  voucherId String
  voucher   Voucher  @relation(fields: [voucherId], references: [id])

  @@unique([userId, voucherId])
}

model Favourite {
  id        String   @id @default(uuid())
  addedAt   DateTime @default(now())
  
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}
