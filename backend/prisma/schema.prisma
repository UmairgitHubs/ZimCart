generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  phone     String?
  avatar    String?
  role      Role     @default(CUSTOMER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isPremium Boolean    @default(false)
  country   String?
  status    UserStatus @default(ACTIVE)

  // Security & Privacy Settings
  isTwoFactorEnabled Boolean @default(false)
  termsConsent       Boolean @default(false)
  privacyConsent     Boolean @default(false)
  dataSharingConsent Boolean @default(true)

  addresses            Address[]
  orders               Order[] @relation("CustomerOrders")
  assignedDeliveries   Order[] @relation("OrderRider")
  favourites           Favourite[]
  paymentMethods       PaymentMethod[]
  notifications        NotificationPreference?
  vouchers             UserVoucher[]
  supportTickets       SupportTicket[]
  searchHistory        SearchHistory[]
  viewHistory          ViewHistory[]
  sessions             UserSession[]
  cart                 Cart?
  refreshToken         String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  twoFactorCode        String?
  twoFactorExpires     DateTime?

  managedStore Store?
  riderProfile RiderProfile?
  riderPayouts RiderPayout[]
  wasteLogs    WasteLog[]

  // Notification Tokens
  pushToken String? @unique // Primary push token

  // Notification History
  notificationHistory Notification[]
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id       String @id @default(uuid())
  quantity Int    @default(1)
  variants Json? // Stores selected variant values e.g. { "Size": "Large" }

  cartId    String
  cart      Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId, variants])
}

model Notification {
  id        String   @id @default(uuid())
  type      String   @default("system") // 'order' | 'promo' | 'system' | 'account'
  title     String
  body      String
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserSession {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName String   @default("Unknown Device")
  deviceType String   @default("mobile") // mobile, tablet, desktop
  os         String   @default("Unknown OS")
  ipAddress  String?
  pushToken  String? // Device-specific push token
  lastActive DateTime @default(now())
  isCurrent  Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model SearchHistory {
  id        String   @id @default(uuid())
  query     String
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ViewHistory {
  id        String   @id @default(uuid())
  productId String?
  storeId   String?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  CUSTOMER
  ADMIN
  STORE_MANAGER
  RIDER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum RiderAvailability {
  AVAILABLE
  DISPATCHED
  OFFLINE
}

model RiderProfile {
  id                String            @id @default(uuid())
  userId            String            @unique
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  nationalId        String?
  vehicleType       String            @default("Motorcycle")
  licensePlate      String?
  homeBaseLabel     String?
  availability      RiderAvailability @default(OFFLINE)
  completedDropoffs Int               @default(0)
  rating            Float             @default(0)
  lastLatitude      Float?
  lastLongitude     Float?
  lastLocationAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PayoutStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

model RiderPayout {
  id          String       @id @default(uuid())
  amount      Float
  method      String
  accountRef  String
  accountName String?
  status      PayoutStatus @default(PENDING)
  notes       String?
  adminNotes  String?
  requestedAt DateTime     @default(now())
  processedAt DateTime?

  riderId String
  rider   User   @relation(fields: [riderId], references: [id], onDelete: Cascade)
}

model Address {
  id           String  @id @default(uuid())
  label        String  @default("Home") // Acts as 'type' e.g. Home, Work, Other
  address      String // Full formatted address string
  detail       String? // House number, floor, etc.
  instructions String? // Delivery instructions
  latitude     Float?
  longitude    Float?
  isDefault    Boolean @default(false)
  userId       String
  user         User    @relation(fields: [userId], references: [id])
}

model PaymentMethod {
  id        String      @id @default(uuid())
  type      PaymentType
  last4     String?
  expiry    String?
  brand     String?
  token     String? // Stripe/Paypal token
  isDefault Boolean     @default(false)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
}

enum PaymentType {
  CARD
  PAYPAL
  APPLE_PAY
  GOOGLE_PAY
  CASH
}

model NotificationPreference {
  id           String  @id @default(uuid())
  emailEnabled Boolean @default(true)
  smsEnabled   Boolean @default(false)
  pushEnabled  Boolean @default(true)

  // General Controls
  soundEnabled     Boolean @default(true)
  vibrationEnabled Boolean @default(true)

  // Granular Controls
  orderUpdatesEnabled    Boolean @default(true)
  deliveryUpdatesEnabled Boolean @default(true)
  promotionalEnabled     Boolean @default(true)
  newArrivalsEnabled     Boolean @default(true)

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
}

// ... Store, Category, Product, Order ... (unchanged)

model Store {
  id           String  @id @default(uuid())
  name         String
  image        String?
  description  String?
  rating       Float   @default(0)
  deliveryTime String? // "30-45 min"
  minOrder     Float   @default(0)
  deliveryFee  Float   @default(0)
  isActive     Boolean @default(true)

  // Real-time Operational Logic
  status       StoreStatus @default(OPEN)
  openingHours Json? // Format: { monday: { open: "09:00", close: "22:00", closed: false }, ... }

  categories Category[]
  products   Product[]
  orders     Order[]

  // Multi-tenancy Isolation
  managerId String?   @unique
  manager   User?     @relation(fields: [managerId], references: [id])
  vouchers  Voucher[]
  wasteLogs WasteLog[]
}

enum StoreStatus {
  OPEN
  CLOSED // Manually closed by manager
  BUSY // High order volume
  HIDDEN // Under maintenance or review
}

model Category {
  id           String  @id @default(uuid())
  name         String
  slug         String? @unique @default(uuid())
  description  String?
  image        String?
  status       String  @default("Published") // "Published", "Draft", "Hidden"
  isFeatured   Boolean @default(false)
  displayOrder Int     @default(0)

  parentCategoryId String?
  parentCategory   Category?  @relation("SubCategories", fields: [parentCategoryId], references: [id])
  children         Category[] @relation("SubCategories")

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  storeId  String
  store    Store     @relation(fields: [storeId], references: [id])
  products Product[]
}

model Product {
  id                 String   @id @default(uuid())
  name               String
  brand              String?
  description        String?
  images             String[] @default([])
  price              Float
  discountPrice      Float?   @default(0)
  costPrice          Float?   @default(0)
  taxPercentage      Float    @default(0)
  sku                String   @unique
  barcode            String?
  inventory          Int      @default(0)
  status             String   @default("Draft")
  subCategory        String?
  isDeal             Boolean  @default(false)
  discountPercentage Int      @default(0)
  weight             String?
  baseUnit           String?  @default("piece") // piece, kg, g, litre, ml, metre, box
  variants           Json? // Stores array of variant objects with prices, stock, and identifiers
  sales              Int      @default(0)

  rating       Float    @default(0)
  reviewsCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  storeId    String
  store      Store    @relation(fields: [storeId], references: [id])

  orderItems OrderItem[]
  favourites Favourite[]
  history    ProductHistory[]
  cartItems  CartItem[]
  wasteLogs  WasteLog[]
}

model ProductHistory {
  id          String   @id @default(uuid())
  event       String // e.g. "Protocol Initiated", "Inventory Alignment", "Price Vector Optimized"
  description String?
  metadata    Json? // For storing specific changes like { oldPrice: 10, newPrice: 12 }
  createdAt   DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

enum WasteReason {
  EXPIRED
  DAMAGED
  LEAKED
  SPOILAGE
  LOST
}

model WasteLog {
  id        String      @id @default(uuid())
  quantity  Int
  unitCost  Float
  totalLoss Float
  reason    WasteReason
  notes     String?
  imageUrl  String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  storeId    String
  store      Store   @relation(fields: [storeId], references: [id])
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  loggedById String
  loggedBy   User    @relation(fields: [loggedById], references: [id])

  @@index([storeId, createdAt])
  @@index([productId])
}

model Order {
  id          String      @id @default(uuid())
  orderNumber String      @unique // e.g. #ORD-12345
  status      OrderStatus @default(PENDING)
  total       Float
  subtotal    Float
  deliveryFee Float
  platformFee Float       @default(0)
  discount    Float       @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  userId  String
  user    User   @relation("CustomerOrders", fields: [userId], references: [id])
  storeId String
  store   Store  @relation(fields: [storeId], references: [id])

  riderId    String?
  rider      User?     @relation("OrderRider", fields: [riderId], references: [id], onDelete: SetNull)
  assignedAt DateTime?

  items         OrderItem[]
  address       String // Snapshot of delivery address
  paymentMethod String // Snapshot of payment method
  notes               String? // External/Internal order notes
  trackingUrl         String?
  proofOfDeliveryUrl  String?
  payment             Payment?
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

model Payment {
  id          String        @id @default(uuid())
  orderId     String        @unique
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String        @default("USD")
  method      String
  status      PaymentStatus @default(PENDING)
  provider    String?
  providerRef String?
  adminNotes  String?
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([createdAt])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPING
  COMPLETED
  CANCELLED
}

model OrderItem {
  id       String @id @default(uuid())
  quantity Int
  price    Float // Price at time of purchase
  name     String @default("Generic Item")
  total    Float

  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
}

model Voucher {
  id           String       @id @default(uuid())
  code         String       @unique
  description  String?
  discountType DiscountType
  value        Float
  minSpend     Float?
  maxDiscount  Float?
  expiryDate   DateTime
  isActive     Boolean      @default(true)

  storeId String?
  store   Store?        @relation(fields: [storeId], references: [id])
  users   UserVoucher[]
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model UserVoucher {
  id     String    @id @default(uuid())
  isUsed Boolean   @default(false)
  usedAt DateTime?

  userId    String
  user      User    @relation(fields: [userId], references: [id])
  voucherId String
  voucher   Voucher @relation(fields: [voucherId], references: [id])

  @@unique([userId, voucherId])
}

model Favourite {
  id      String   @id @default(uuid())
  addedAt DateTime @default(now())

  userId    String
  user      User    @relation(fields: [userId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
}

// Help & Support Models

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String? // e.g. "Orders", "Payments", "Account"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SupportTicket {
  id        String       @id @default(uuid())
  subject   String
  message   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}
